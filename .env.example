# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momo_toms_cottage"

# Auth
AUTH_SECRET="replace-with-secure-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google Calendar
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google-calendar/callback"

# Spotify
SPOTIFY_CLIENT_ID="your-spotify-client-id"
SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/integrations/spotify/callback"

# Apple Music
APPLE_MUSIC_TEAM_ID="your-team-id"
APPLE_MUSIC_KEY_ID="your-key-id"
APPLE_MUSIC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_MUSIC_REDIRECT_URI="http://localhost:3000/api/integrations/apple-music/callback"

# Storage
STORAGE_BUCKET_NAME="momo-toms-cottage"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID="your-storage-key"
STORAGE_SECRET_ACCESS_KEY="your-storage-secret"
STORAGE_ENDPOINT="https://your-storage-endpoint"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
